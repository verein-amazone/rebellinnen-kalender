<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- adjustNothing: the WebView keeps its full height while the keyboard is open, the same as
             iOS's Keyboard resize 'none' (capacitor.config.ts). adjustResize squeezed the fixed h-dvh
             shell into the space above the keyboard, tab bar included; adjustPan slid the whole
             window up. @capacitor/keyboard still reports the keyboard height from the IME insets,
             and the app pads its sheets and scroll region by it (keyboard-visibility.ts). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true" />

        <!-- One activity-alias per selectable app icon (#9). The launcher entry lives on the
             aliases rather than on MainActivity itself, because switching the icon at runtime means
             enabling one alias and disabling the others; @capawesome/capacitor-app-icon does that
             through PackageManager and identifies the icon by the alias name without its leading
             dot ("CoolCatLila", "SamOrange", ...).

             Exactly one alias may be android:enabled="true": the plugin treats the first enabled
             launcher component in this file as the default, and that is the one resetIcon() and the
             „Cool Cat Nacht“ option return to. The bitmaps are generated by
             scripts/generate-app-icons.mjs.

             Never reuse a removed alias name. Android keeps the enabled state the plugin set for a
             component across updates, so an old name brought back could start disabled and leave
             the app without any launcher entry. The cat icons therefore replaced Klassisch, Pixel
             and Nacht under new names. -->
        <activity-alias
            android:name=".CoolCatNacht"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/title_activity_main"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <activity-alias
            android:name=".CoolCatLila"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cool_cat_lila"
            android:roundIcon="@mipmap/ic_launcher_cool_cat_lila_round"
            android:label="@string/title_activity_main"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <activity-alias
            android:name=".CoolCatHell"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cool_cat_hell"
            android:roundIcon="@mipmap/ic_launcher_cool_cat_hell_round"
            android:label="@string/title_activity_main"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <activity-alias
            android:name=".SamOrange"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sam_orange"
            android:roundIcon="@mipmap/ic_launcher_sam_orange_round"
            android:label="@string/title_activity_main"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <activity-alias
            android:name=".SamTuerkis"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sam_tuerkis"
            android:roundIcon="@mipmap/ic_launcher_sam_tuerkis_round"
            android:label="@string/title_activity_main"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <activity-alias
            android:name=".SamHell"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sam_hell"
            android:roundIcon="@mipmap/ic_launcher_sam_hell_round"
            android:label="@string/title_activity_main"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- @ebarooni/capacitor-calendar (#20 device-calendar connection) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- @capacitor/local-notifications (#81 appointment reminders). The plugin itself declares
         POST_NOTIFICATIONS, RECEIVE_BOOT_COMPLETED and SCHEDULE_EXACT_ALARM. A calendar app may hold
         USE_EXACT_ALARM, which Android 13+ grants without asking, so a reminder arrives on time
         instead of in the next inexact batch; it needs the "exact alarm" declaration in the Play
         Console. SCHEDULE_EXACT_ALARM only remains for Android 12, where USE_EXACT_ALARM does not
         exist yet. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- @capacitor-community/sqlite pulls in androidx.biometric for its optional biometric database
         lock, which brings these two along. The app never uses that lock, so they are removed rather
         than listed on the Play listing for nothing. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
</manifest>
