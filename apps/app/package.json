{
  "name": "@amazone/app",
  "description": "The Rebell*innen Kalender phone app: Angular in a Capacitor WebView.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-app-version.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/generate-app-version.mjs",
    "build": "ng build",
    "postbuild": "node scripts/copy-third-party-licenses.mjs",
    "prebuild:demo": "node scripts/generate-app-version.mjs",
    "build:demo": "ng build --configuration production,demo",
    "postbuild:demo": "node scripts/copy-third-party-licenses.mjs dist/demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "e2e": "playwright test",
    "store:screenshots": "pnpm build && playwright test -c playwright.store.config.ts",
    "serve:dist": "serve -s dist/rebellinnen-kalender/browser -l 4200",
    "cap:sync": "pnpm build && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@amazone/design-system": "workspace:*",
    "@amazone/legal": "workspace:*",
    "@angular/aria": "^22.2.6",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/text-zoom": "^8.0.1",
    "@capawesome/capacitor-accessibility-preferences": "^0.1.2",
    "@capawesome/capacitor-app-icon": "^0.1.2",
    "@capawesome/capacitor-haptics": "^0.2.0",
    "@capawesome/capacitor-shake": "^0.1.2",
    "@capawesome/capacitor-youtube-player": "^0.1.4",
    "@ebarooni/capacitor-calendar": "^8.10.0",
    "@independo/capacitor-emoji-picker": "^1.3.5",
    "@lucide/angular": "^1.70.0",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "capacitor-native-settings": "^8.2.0",
    "dompurify": "^3.4.17",
    "ical.js": "^2.2.1",
    "linkifyjs": "^4.4.0",
    "marked": "^18.1.3",
    "rrule-temporal": "2.2.8",
    "rxjs": "~7.8.2",
    "temporal-polyfill": "^1.0.8",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@axe-core/playwright": "catalog:",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.14.0",
    "eslint": "catalog:",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "serve": "catalog:",
    "sharp": "^0.35.5",
    "spdx-satisfies": "^6.0.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "^5.1.0"
  }
}
