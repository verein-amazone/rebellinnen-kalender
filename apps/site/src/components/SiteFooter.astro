---
import { LEGAL_PAGES } from '../lib/site';
import NewTabLink from './NewTabLink.astro';

interface Props {
  /** The page the footer is on, so its own link says so (`aria-current`). */
  currentPath: string | null;
}

const { currentPath } = Astro.props;

const links = [
  ...LEGAL_PAGES.map(({ title, path }) => ({ title, href: path })),
  { title: 'Verein Amazone', href: 'https://www.amazone.or.at/' },
];
const year = new Date().getFullYear();
---

<footer class="on-navy pt-12 pb-[calc(3rem+env(safe-area-inset-bottom))] text-fine">
  <div class="wrap grid gap-8 split:grid-cols-2 split:gap-x-[clamp(2rem,6vw,4rem)]">
    <div>
      <nav aria-label="Rechtliches und Kontakt">
        <ul class="flex flex-wrap gap-x-6">
          {links.map(({ title, href }) => (
            <li>
              <NewTabLink
                href={href}
                aria-current={href === currentPath ? 'page' : undefined}
                class="inline-flex min-h-touch items-center font-semibold aria-[current=page]:text-rebel-text-muted aria-[current=page]:no-underline"
              >
                {title}
              </NewTabLink>
            </li>
          ))}
        </ul>
      </nav>
      <p class="text-rebel-text-muted">© {year} Verein Amazone · Entwickelt von Independo GmbH</p>
    </div>
    <div class="grid max-w-160 gap-4 text-rebel-text-muted">
      <p>
        Die App ist 2026 im Rahmen des Projekts #grlpwr – Mädchen* gestalten Gesellschaft
        entstanden. Gefördert von ProEuropean Values AT und kofinanziert von der Europäischen Union.
        Ebenfalls gefördert von der Hil-Foundation.
      </p>
      <div class="flex flex-wrap items-center gap-x-8 gap-y-5 [&_img]:h-11 [&_img]:w-auto">
        <img
          src="/assets/logos/eu-kofinanziert-neg.svg"
          width="1003"
          height="220"
          alt="Kofinanziert von der Europäischen Union"
        />
        <img
          src="/assets/logos/peva-cerv-neg.webp"
          width="1024"
          height="274"
          alt="ProEuropean Values AT – CERV"
        />
        <img
          src="/assets/logos/hil-foundation-weiss.webp"
          width="203"
          height="88"
          alt="Hil-Foundation"
        />
      </div>
    </div>
  </div>
</footer>
