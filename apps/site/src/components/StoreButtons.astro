---
/**
 * Both store badges, or „Bald verfügbar …“ for a store whose listing is not public yet
 * (site.config.json). The badges are the stores' own, unaltered, as their guidelines ask.
 */
import { APP_NAME, STORES } from '../lib/site';

interface Props {
  /** The surface the row sits on; the „Bald verfügbar“ pill takes the other light tone. */
  surface?: 'teal' | 'cream';
  class?: string;
}

const { surface = 'teal', class: className } = Astro.props;

const missing = [
  STORES.appStore ? null : 'im App Store',
  STORES.playStore ? null : 'bei Google Play',
].filter((store) => store !== null);
---

<div class:list={['flex flex-wrap items-center gap-x-4 gap-y-3', className]}>
  {STORES.appStore && (
    <a
      class="inline-flex rounded-[0.6rem] transition-transform duration-160 ease-(--ease-out) hoverable:-translate-y-0.5 active:scale-97"
      href={STORES.appStore}
    >
      {/* Apple's badge has no clear space of its own; Google's PNG carries 11.6 % above and
            below. Both end up the same visible height, as the badge guidelines ask. */}
      <img
        src="/assets/badges/app-store-de.svg"
        width="120"
        height="40"
        alt={`${APP_NAME} im App Store laden`}
        class="h-13 w-auto"
      />
    </a>
  )}
  {STORES.playStore && (
    <a
      class="inline-flex rounded-[0.6rem] transition-transform duration-160 ease-(--ease-out) hoverable:-translate-y-0.5 active:scale-97"
      href={STORES.playStore}
    >
      <img
        src="/assets/badges/google-play-de.png"
        width="646"
        height="250"
        alt={`${APP_NAME} bei Google Play laden`}
        class="-my-[0.49rem] h-[4.23rem] w-auto"
      />
    </a>
  )}
  {missing.length > 0 && (
    <p
      class:list={[
        'inline-flex min-h-13 items-center gap-2.5 rounded-full px-4.5 py-2.5 font-display text-lg leading-snug font-medium',
        surface === 'teal' ? 'bg-card' : 'bg-muted',
      ]}
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="size-5.5 flex-none"
      >
        <rect x="3" y="4" width="18" height="18" rx="2" />
        <path d="M16 2v4M8 2v4M3 10h18" />
      </svg>
      Bald verfügbar {missing.join(' und ')}
    </p>
  )}
</div>
