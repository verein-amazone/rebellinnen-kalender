---
/**
 * The target of the printed QR codes. public/download/download.js sends a phone straight to its
 * store; without it, on a computer, or before a listing is public, this is a plain page with the
 * store buttons it has.
 */
import StoreButtons from '../components/StoreButtons.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_NAME, SUBTITLE } from '../lib/site';
---

<BaseLayout
  title={`${APP_NAME} laden`}
  description={`${APP_NAME} für dein Handy: im App Store und bei Google Play.`}
  path="/download/"
  header={false}
  script="/download/download.js"
>
  <main
    id="inhalt"
    class="wrap grid flex-1 content-start justify-items-center gap-5 py-[clamp(2.5rem,10vw,6rem)] text-center"
  >
    <img src="/assets/icon.webp" alt="" width="256" height="256" class="size-24" />
    <h1 class="text-[clamp(3.25rem,15vw,6rem)] leading-[0.92] tracking-[-0.02em]">{APP_NAME}</h1>
    <p class="font-display text-[clamp(1.5rem,5.5vw,2.25rem)] leading-tight font-medium">
      {SUBTITLE}
    </p>
    <StoreButtons class="justify-center" />
    <p class="max-w-[28ch] text-lead empty:hidden" id="download-status" role="status"></p>
    <a class="inline-flex min-h-touch items-center font-semibold" href="/">
      Mehr über die App
    </a>
  </main>
</BaseLayout>
