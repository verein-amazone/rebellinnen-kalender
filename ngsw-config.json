{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/pr-*",
    "!/pr-*/**",
    "!/datenschutz",
    "!/datenschutz/**",
    "!/nutzungsbedingungen",
    "!/nutzungsbedingungen/**",
    "!/impressum",
    "!/impressum/**"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/404.html",
          "/*.css",
          "/*.js",
          "/assets/sqlite3.wasm",
          "/legal/*.md"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalogs",
      "urls": [
        "/content/catalog.json",
        "/curated-calendars/catalog.json",
        "/support-services/catalog.json",
        "/content/images.json",
        "/3rdpartylicenses.txt"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 10,
        "maxAge": "30d",
        "timeout": "5s"
      }
    }
  ]
}
