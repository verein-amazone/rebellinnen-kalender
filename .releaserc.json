{
  "branches": ["main", { "name": "dev", "prerelease": "rc" }],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          { "type": "build", "release": "patch" },
          { "type": "chore", "release": "patch" },
          { "type": "ci", "release": "patch" },
          { "type": "improvement", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "revert", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Features" },
            { "type": "fix", "section": "Bug Fixes" },
            { "type": "improvement", "section": "Improvements" },
            { "type": "perf", "section": "Performance" },
            { "type": "revert", "section": "Reverts" },
            { "type": "build", "section": "Build" },
            { "type": "chore", "section": "Chores" },
            { "type": "ci", "section": "Delivery" },
            { "type": "refactor", "section": "Refactoring" }
          ]
        }
      }
    ],
    "@semantic-release/changelog",
    ["@semantic-release/npm", { "npmPublish": false }],
    [
      "@semantic-release/exec",
      {
        "generateNotesCmd": "node apps/app/scripts/hand-written-release-notes.mjs ${nextRelease.version}",
        "prepareCmd": "node apps/app/scripts/generate-app-version.mjs && node apps/app/scripts/sync-native-version.mjs",
        "successCmd": "printf 'released=true\\nversion=%s\\ntag=%s\\n' '${nextRelease.version}' '${nextRelease.gitTag}' >> \"$GITHUB_OUTPUT\""
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "apps/app/src/app/cross-cutting/infrastructure/app-version.ts",
          "apps/app/ios/App/App.xcodeproj/project.pbxproj",
          "apps/app/android/app/build.gradle"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false
      }
    ]
  ]
}
