<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- adjustResize: the WebView shrinks when the keyboard opens, so the fixed h-dvh shell
             (main-navigation.scaffold.html) recomputes to the smaller viewport and the bottom tab
             bar ends up flush above the keyboard. The default (adjustPan) instead pans the whole
             window, leaving the tab bar floating above the keyboard with a gap below it. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true" />

        <!-- One activity-alias per selectable app icon (#9). The launcher entry lives on the
             aliases rather than on MainActivity itself, because switching the icon at runtime means
             enabling one alias and disabling the others; @capawesome/capacitor-app-icon does that
             through PackageManager and identifies the icon by the alias name without its leading
             dot ("Pixel", "Nacht").

             Exactly one alias may be android:enabled="true": the plugin treats the first enabled
             launcher component in this file as the default, and that is the one resetIcon() and the
             „Klassisch“ option return to. The bitmaps are generated by
             scripts/generate-app-icons.mjs. -->
        <activity-alias
            android:name=".Klassisch"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/title_activity_main"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <activity-alias
            android:name=".Pixel"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pixel"
            android:roundIcon="@mipmap/ic_launcher_pixel_round"
            android:label="@string/title_activity_main"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <activity-alias
            android:name=".Nacht"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nacht"
            android:roundIcon="@mipmap/ic_launcher_nacht_round"
            android:label="@string/title_activity_main"
            android:targetActivity=".MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- @ebarooni/capacitor-calendar (#20 device-calendar connection) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- @capacitor/local-notifications (#81 appointment reminders). The plugin itself declares
         POST_NOTIFICATIONS, RECEIVE_BOOT_COMPLETED and SCHEDULE_EXACT_ALARM. A calendar app may hold
         USE_EXACT_ALARM, which Android 13+ grants without asking, so a reminder arrives on time
         instead of in the next inexact batch; it needs the "exact alarm" declaration in the Play
         Console. SCHEDULE_EXACT_ALARM only remains for Android 12, where USE_EXACT_ALARM does not
         exist yet. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
</manifest>
