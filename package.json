{
  "name": "rebellinnen-kalender",
  "version": "1.0.0-rc.20",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verein-amazone/rebellinnen-kalender.git"
  },
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-app-version.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/generate-app-version.mjs",
    "build": "ng build",
    "postbuild": "node scripts/copy-third-party-licenses.mjs",
    "prebuild:pages": "node scripts/generate-app-version.mjs",
    "build:pages": "ng build --configuration production,pages",
    "postbuild:pages": "node scripts/copy-third-party-licenses.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "serve:dist": "serve -s dist/rebellinnen-kalender/browser -l 4200",
    "deps:update": "scripts/update-app-dependencies.sh",
    "cap:sync": "pnpm build && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android"
  },
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@angular/aria": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/service-worker": "^22.2.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/text-zoom": "^8.0.1",
    "@capawesome/capacitor-accessibility-preferences": "^0.1.2",
    "@capawesome/capacitor-app-icon": "^0.1.2",
    "@capawesome/capacitor-haptics": "^0.1.2",
    "@capawesome/capacitor-shake": "^0.1.2",
    "@ebarooni/capacitor-calendar": "^8.7.1",
    "@independo/capacitor-emoji-picker": "^1.3.2",
    "@lucide/angular": "^1.52.0",
    "capacitor-native-settings": "^8.2.0",
    "dompurify": "^3.4.16",
    "ical.js": "^2.2.1",
    "marked": "^18.0.14",
    "rrule-temporal": "2.0.2",
    "rxjs": "~7.8.2",
    "temporal-polyfill": "^1.0.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "angular-eslint": "22.1.0",
    "axe-core": "^4.13.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.12.0",
    "jeep-sqlite": "^2.8.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.9",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.11"
  }
}
