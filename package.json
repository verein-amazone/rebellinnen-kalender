{
  "name": "rebellinnen-kalender",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "serve:dist": "serve -s dist/rebellinnen-kalender/browser -l 4200",
    "deps:update": "scripts/update-app-dependencies.sh",
    "cap:sync": "pnpm build && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android"
  },
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@angular/aria": "^22.1.1",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/text-zoom": "^8.0.1",
    "@capawesome/capacitor-accessibility-preferences": "^0.1.1",
    "@ebarooni/capacitor-calendar": "^8.2.0",
    "@lucide/angular": "^1.28.0",
    "dompurify": "^3.4.13",
    "ical.js": "^2.2.1",
    "marked": "^18.0.9",
    "rrule-temporal": "2.0.2",
    "rxjs": "~7.8.2",
    "temporal-polyfill": "^1.0.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "angular-eslint": "22.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.0",
    "jeep-sqlite": "^2.8.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.10"
  }
}
